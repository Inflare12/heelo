{
  "name": "liveshare-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "LiveShare collaborative browsing desktop client",
  "author": "Inflare12",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.inflare.liveshare",
    "productName": "LiveShare",
    "files": ["main.cjs", "preload.cjs"],
    "win": { "target": "nsis", "artifactName": "LiveShare-${version}-Setup.${ext}" }
  }
}
